# PICO8-OS kernel trim, applied on top of the Raspberry Pi defconfigs
# (bcmrpi / bcm2709 / bcm2711 / bcm2712). Those build almost every driver as
# a module; a PICO-8 console needs a small part of that. Fewer drivers =
# much shorter builds and a smaller image.
#
# Deliberately KEPT (do not add these here):
#   display  DRM_VC4, DRM_V3D, CEC          audio  SND, SND_SOC, SND_BCM2835
#   storage  MMC, EXT4, VFAT, NLS, USB_STORAGE (PICO-8 zip from a USB stick)
#   input    USB_HID, HID_GENERIC, HIDRAW, UHID, INPUT_EVDEV, INPUT_JOYDEV,
#            JOYSTICK_XPAD, HID_SONY/PLAYSTATION/NINTENDO/MICROSOFT/STEAM...
#   radio    BT (HCIUART/BCM, HCIBTUSB, HIDP), CFG80211, BRCMFMAC
#   network  Ethernet drivers (SMSC95XX, LAN78XX, GENET, MACB), IPv4/IPv6
#   system   WATCHDOG/BCM2835_WDT, HWMON (under-voltage), STAGING (vchiq),
#            BCM_VCIO (/dev/vcio: firmware tryboot flag for OTA updates)
# scripts/check-kernel-trim.py verifies these against the real defconfigs.

# Cameras, video capture/codecs, DVB, analog TV, radio tuners
# CONFIG_MEDIA_SUPPORT is not set

# Firewall, traffic shaping, tunnels and exotic protocols: an appliance
# behind a home router does not route or filter packets.
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_L2TP is not set
# CONFIG_MPLS is not set
# CONFIG_IP_SCTP is not set
# CONFIG_ATM is not set
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_6LOWPAN is not set
# CONFIG_IEEE802154 is not set
# CONFIG_WIREGUARD is not set
# CONFIG_NET_9P is not set
# CONFIG_CEPH_LIB is not set

# Filesystems the console never mounts (FAT + ext4 only)
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_NTFS3_FS is not set
