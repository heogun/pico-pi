# ---- shared by every Raspberry Pi target ----
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/post-image.sh"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
# Drop kernel subsystems a PICO-8 console never uses (about half the modules;
# see the fragment and scripts/check-kernel-trim.py)
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/linux-trim.fragment $(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/linux-fastboot.fragment $(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/linux-harden.fragment"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/cmdline.txt"
# Wi-Fi (Zero W / 3 / 4 / 5) for Splore
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
# Wi-Fi first setup: access point + captive portal when no network is known
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_IW=y
# Bluetooth gamepads (onboard on Zero W / 3 / 4 / 5, USB dongles on others)
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_SIXAXIS=y

# One-shot boot of a new system slot (pico8os-ota, firmware tryboot.txt)
BR2_PACKAGE_PICO8OS_TRYBOOT=y
