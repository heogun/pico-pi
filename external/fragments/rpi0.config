# Pi 1 A/B/A+/B+, Zero, Zero W, CM1 (BCM2835, ARMv6, 32-bit)
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2708-rpi-zero-w broadcom/bcm2708-rpi-zero broadcom/bcm2708-rpi-b broadcom/bcm2708-rpi-b-rev1 broadcom/bcm2708-rpi-b-plus broadcom/bcm2708-rpi-cm"
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/config_32.txt"
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
# Board name for post-build/post-image (OTA bundle, /etc/pico8os/board)
BR2_ROOTFS_POST_SCRIPT_ARGS="rpi0"
