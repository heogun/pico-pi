# Pi 3 B/B+/A+, Zero 2 W, CM3 (BCM2837, 32-bit userland)
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-3-b broadcom/bcm2710-rpi-3-b-plus broadcom/bcm2710-rpi-cm3 broadcom/bcm2710-rpi-zero-2-w"
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_PICOPI_PATH)/board/rpi/config_32.txt"
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
# Board name for post-build/post-image (OTA bundle, /etc/picopi/board)
BR2_ROOTFS_POST_SCRIPT_ARGS="rpi3"
