# ---- PICO-PI common settings (appended after the upstream board defconfig) ----
BR2_TARGET_GENERIC_HOSTNAME="picopi"
BR2_TARGET_GENERIC_ISSUE="PICO-PI"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PICOPI_PATH)/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PICOPI_PATH)/board/common/post-build.sh"
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# Root stays read-only (power cuts can't corrupt it); only the FAT data
# partition is written. The installer remounts rw just while unpacking.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PICOPI_PATH)/board/common/busybox.fragment"

# Graphics: KMS/DRM + GBM + EGL/GLES for SDL2 kmsdrm backend
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_KMSDRM=y

# Audio
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y

# Tools used by the PICO-8 installer / boot partition handling
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
# Keyboard layouts (loadkeys + keymaps). SDL2's evdev keyboard reads the
# console keymap, so this sets the layout PICO-8 types with.
BR2_PACKAGE_KBD=y
# PICO-8 shells out to wget for Splore/BBS downloads (HTTPS). busybox wget
# without TLS fails/hangs -> GNU wget with OpenSSL, timeouts in /etc/wgetrc.
BR2_PACKAGE_OPENSSL=y
# openssl CLI verifies OTA bundle signatures
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_WGET=y

# Ctrl+Alt+Backspace / SELECT+START (3 s) force-restarts a frozen PICO-8
BR2_PACKAGE_PICO8_HOTKEY=y
# Up-to-date controller mappings (SDL_GameControllerDB)
BR2_PACKAGE_SDL_GAMECONTROLLERDB=y
# SDL2 HIDAPI drivers (PS/Switch/Xbox/Steam over hidraw + libusb)
BR2_PACKAGE_PICOPI_SDL2_HIDAPI=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_CA_CERTIFICATES=y

BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
