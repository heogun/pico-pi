# Pi 5, Pi 500 (BCM2712, 64-bit only -> uses pico8_64)
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/config_5.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/cmdline_5.txt"
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
# keep upstream's 4k page size fragment, plus the PICO8-OS trim
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment $(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/linux-trim.fragment $(BR2_EXTERNAL_PICO8OS_PATH)/board/rpi/linux-fastboot.fragment"
# Board name for post-build/post-image (OTA bundle, /etc/pico8os/board)
BR2_ROOTFS_POST_SCRIPT_ARGS="rpi5"
