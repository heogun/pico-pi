#!/bin/sh
# Bluetooth policy from pico8os.txt: BLUETOOTH=off powers the radio down;
# otherwise, if BT_PAIR_SECONDS is set (default 0 = no), open a pairing
# window for that long after boot.
[ "$1" = start ] || exit 0
command -v bluetoothctl >/dev/null || exit 0
. /usr/lib/pico8os/lib.sh
load_config
if [ "$BLUETOOTH" = off ]; then
	(sleep 3; bluetoothctl power off >/dev/null 2>&1) &
	exit 0
fi
case $BT_PAIR_SECONDS in ''|*[!0-9]*) BT_PAIR_SECONDS=0 ;; esac   # invalid: no window
[ "$BT_PAIR_SECONDS" -gt 0 ] && pico8-btpair "$BT_PAIR_SECONDS" >/dev/null 2>&1 &
exit 0
