#!/bin/sh
# A new system slot is "good" once the console has really started: the same
# PICO-8 process (or, while PICO-8 is not installed, the same installer
# screen waiting for the zip) has stayed up for STABLE seconds. The session
# launcher alone is not enough: it also runs while PICO-8 crash-loops, and a
# crash loop changes the PID every time, so it never counts. If nothing is
# stable within WINDOW seconds the slot stays on trial (S06ota and the
# firmware tryboot decide at the next boot).
[ "$1" = start ] || exit 0
[ -f /state/ota/pending ] || exit 0
STABLE=45 WINDOW=600 STEP=5

# ready_id: "game:PID" / "install:PID" of what is on screen, or nothing.
ready_id() {
	p=$(pidof pico8_64 pico8_dyn pico8 2>/dev/null) && { echo "game:${p%% *}"; return; }
	p=$(pidof pico8-install 2>/dev/null) && echo "install:${p%% *}"
}

(
	last='' up=0 t=0
	while [ $t -lt $WINDOW ]; do
		id=$(ready_id)
		if [ -n "$id" ] && [ "$id" = "$last" ]; then up=$((up + STEP)); else up=0; fi
		last=$id
		if [ $up -ge $STABLE ]; then
			pico8os-ota mark-good
			exit 0
		fi
		sleep $STEP; t=$((t + STEP))
	done
	. /usr/lib/pico8os/lib.sh
	mkdir -p "$DATA/logs"
	echo "$(date '+%F %T') PICO-8 never ran steadily for ${STABLE}s; slot stays on trial" >> "$DATA/logs/ota.log"
) </dev/null >/dev/null 2>&1 &
exit 0
