#!/bin/sh
# PICO8-OS web API (busybox httpd CGI). /cgi-bin/api?a=ACTION&...
# Uploads are raw request bodies (fetch(url, {method:'POST', body:file})),
# so no multipart parsing is needed.
# Replies carry a message code + argument ({"ok":..,"code":..,"arg":..});
# the page translates api_<code> (and OTA status codes) via i18n.js.
#
# Runs as the unprivileged www user (lighttpd). It reads and writes the data
# partition itself (group www); everything that needs root goes through priv
# (lib.sh) to pico8os-agent, which only runs whitelisted commands.
# Every state change needs POST + "X-Pico8os: 1" (CSRF).
# Two listeners (see pico8os-web), told apart by PICO8OS_LISTENER, which the
# server sets (a client cannot):
#   admin  (HTTPS) every action needs a login session (cookie sid) except
#          "login" itself, always, whatever mode Wi-Fi is in. Failed logins
#          slow down one client at a time (see note_failure).
#   ap     (plain HTTP, bound to the setup network's address only, while the
#          setup access point runs) only status / wifi_scan / wifi_set,
#          without login; wifi_set can change the Wi-Fi network and nothing
#          else (pico8os-agent keeps it in its own root-only file).
. /usr/lib/pico8os/lib.sh
load_config

MAX_TEXT=65536

hdr() { printf 'Content-Type: %s\r\nCache-Control: no-store\r\n\r\n' "${1:-application/json}"; }
# ok|fail CODE [ARG]
reply() {
	hdr
	printf '{"ok":%s,"code":%s,"arg":%s}\n' "$1" "$(json_str "$2")" "$(json_str "${3:-}")"
	exit 0
}
ok() { reply true "$1" "${2:-}"; }
fail() { printf 'Status: 400 Bad Request\r\n'; reply false "$1" "${2:-}"; }
# OTA results: the code is "ota", the argument the OTA status line.
ota_reply() { "$1" ota "$(cat "$RUN/ota.status" 2>/dev/null)"; }
need_login() { printf 'Status: 401 Unauthorized\r\n'; reply false login_required; }

# ---- sessions and login rate limiting ----
SESS_DIR="$RUN/sessions"; AUTH_DIR="$RUN/auth"; SESSION_TTL=43200
now=$(date +%s)
LISTENER=${PICO8OS_LISTENER:-admin}
session_id() {
	printf '%s' "${HTTP_COOKIE:-}" | tr ';' '\n' | sed -n 's/^ *sid=\([0-9a-f]\{48\}\)$/\1/p' | head -n 1
}
check_session() {
	sid=$(session_id)
	[ -n "$sid" ] && [ -f "$SESS_DIR/$sid" ] || return 1
	if [ $(( now - $(stat -c %Y "$SESS_DIR/$sid") )) -ge $SESSION_TTL ]; then
		rm -f "$SESS_DIR/$sid"; return 1
	fi
	touch "$SESS_DIR/$sid"
}
# Login rate limiting, updated under a lock (concurrent requests):
#  per client "<failures> <locked-until> <last-failure>": 5 free tries, then
#    30 s doubling up to 15 min; forgotten 15 min after the last failure
#    and on a successful login;
#  all clients "<window-start> <failures>": more than 30 failures within a
#    minute pause logins for the rest of that minute only, so no client can
#    lock the owner out for long.
CLIENT_FREE=5 CLIENT_MAX_LOCK=900 CLIENT_FORGET=900 GLOBAL_WINDOW=60 GLOBAL_MAX=30
ip_file() { printf '%s/%s' "$AUTH_DIR" "$(printf '%s' "${REMOTE_ADDR:-unknown}" | tr -c '0-9A-Fa-f' '_')"; }
auth_lock() {
	i=0
	until mkdir "$AUTH_DIR/.lock" 2>/dev/null; do
		# a lock older than 10 s belongs to a request that died
		if [ $(( now - $(stat -c %Y "$AUTH_DIR/.lock" 2>/dev/null || echo "$now") )) -gt 10 ]; then
			rmdir "$AUTH_DIR/.lock" 2>/dev/null; continue
		fi
		i=$((i + 1)); [ $i -gt 50 ] && return 1
		sleep 0.1
	done
}
auth_unlock() { rmdir "$AUTH_DIR/.lock" 2>/dev/null; }
# write FILE atomically
auth_put() { printf '%s\n' "$2" > "$1.$$" && mv "$1.$$" "$1"; }
# login_wait: seconds this client must still wait (0 = may try)
login_wait() {
	read -r _ until _ 2>/dev/null < "$(ip_file)" || until=0
	w=0; [ "$until" -gt "$now" ] && w=$(( until - now ))
	read -r start count 2>/dev/null < "$AUTH_DIR/_all" || { start=0; count=0; }
	if [ "$count" -gt "$GLOBAL_MAX" ] && [ $(( now - start )) -lt "$GLOBAL_WINDOW" ]; then
		g=$(( start + GLOBAL_WINDOW - now )); [ "$g" -gt "$w" ] && w=$g
	fi
	echo "$w"
}
note_failure() {
	ipf=$(ip_file)
	read -r f until last 2>/dev/null < "$ipf" || { f=0; until=0; last=0; }
	[ $(( now - last )) -ge "$CLIENT_FORGET" ] && f=0
	f=$((f + 1))
	if [ "$f" -ge "$CLIENT_FREE" ]; then
		d=$(( 30 << (f - CLIENT_FREE) )); { [ "$d" -gt "$CLIENT_MAX_LOCK" ] || [ "$d" -le 0 ]; } && d=$CLIENT_MAX_LOCK
		until=$(( now + d ))
	fi
	auth_put "$ipf" "$f $until $now"
	read -r start count 2>/dev/null < "$AUTH_DIR/_all" || { start=0; count=0; }
	if [ $(( now - start )) -ge "$GLOBAL_WINDOW" ]; then auth_put "$AUTH_DIR/_all" "$now 1"
	else auth_put "$AUTH_DIR/_all" "$start $(( count + 1 ))"; fi
}

# priv_or_fail CMD...: run a privileged action; the request fails with it
priv_or_fail() { priv "$@" >/dev/null 2>&1 || fail unknown_action; }

urldecode() {
	printf '%b' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/+/ /g' \
		-e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}
# param NAME [STRING]: value of NAME in STRING (default: the query string)
param() {
	src=${2-$QUERY_STRING}
	old_ifs=$IFS; IFS='&'
	for kv in $src; do
		case $kv in "$1="*) IFS=$old_ifs; urldecode "${kv#*=}"; return 0 ;; esac
	done
	IFS=$old_ifs
	return 1
}
body() { head -c "${CONTENT_LENGTH:-0}"; }
# save_body DIR NAME: store the whole request body as DIR/NAME (written to a
# hidden .part file first). Fails, leaving nothing behind, when the disk is
# full or the client sent less than it announced.
save_body() {
	sb_part="$1/.$2.part"
	if body > "$sb_part" && [ "$(wc -c < "$sb_part")" -eq "${CONTENT_LENGTH:-0}" ] \
		&& mv "$sb_part" "$1/$2" && sync; then
		return 0
	fi
	rm -f "$sb_part"; return 1
}
# room_for MAXBYTES: the upload is at most MAXBYTES and leaves 32 MB of
# PICO8DATA free.
# (Own variable names: callers keep the file name in $n.)
room_for() {
	rf_len=${CONTENT_LENGTH:-0}
	case $rf_len in ''|*[!0-9]*) return 1 ;; esac
	[ "$rf_len" -le "$1" ] || return 1
	rf_free=$(df -k "$DATA" 2>/dev/null | awk 'NR == 2 {print $4}')
	[ $(( ${rf_free:-0} * 1024 - rf_len )) -ge $((32 * 1048576)) ]
}
need_post() { [ "$REQUEST_METHOD" = POST ] || fail post_required; }  # (also enforced globally below)

# File names from the browser: one path component, no hidden files.
safe_name() {
	n=$(printf '%s' "$1" | tr -d '/\\\r\n' | tr -c 'A-Za-z0-9._ ()+-' '_')
	case $n in ''|.*) return 1 ;; esac
	printf '%s' "$n"
}

json_list() { # lines on stdin -> JSON array of strings
	first=1; printf '['
	while IFS= read -r l; do
		[ $first = 1 ] || printf ','; first=0
		json_str "$l"
	done
	printf ']'
}

pico8_version() {
	v=$(grep -m1 -o 'PICO-8 v[0-9][0-9.a-z]*' "$PICO8_DIR/pico-8_manual.txt" 2>/dev/null)
	if [ -n "$v" ]; then echo "${v#PICO-8 }"
	elif is_installed; then echo "@installed"
	else echo "@none"
	fi
}

wifi_state() {
	if [ -f "$RUN/ap-mode" ]; then echo "ap:$(cat "$RUN/ap-ssid" 2>/dev/null)"
	elif s=$(iw dev wlan0 link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p') && [ -n "$s" ]; then echo "on:$s"
	elif [ -e /sys/class/net/wlan0 ]; then echo "off"
	else echo "none"
	fi
}

AP_ONLY="status wifi_scan wifi_set"
READ_ONLY="status conf_get carts shots shot log bt_list wifi_scan policy"
action=$(param a) || action=status
case $LISTENER in
ap)
	# only on the setup network's own address (pico8os-web binds it there)
	[ "${SERVER_ADDR:-}" = 192.168.4.1 ] || fail ap_only
	case " $AP_ONLY " in *" $action "*) ;; *) fail ap_only ;; esac ;;
*)
	# DNS rebinding: only answer for the console's own address or name.
	host=${HTTP_HOST%:*}
	case $host in
		''|localhost|pico8os|pico8os.local) ;;
		\[*\]) ;;                       # IPv6 literal
		*[!0-9.]*) fail bad_origin ;;   # not an IPv4 literal
	esac ;;
esac
# CSRF: anything that changes state must be a POST carrying X-Pico8os: 1
# (a custom header a foreign web page cannot send without a CORS preflight,
# which this server never grants) and, if the browser sends one, a matching
# Origin. Read-only actions may be GET.
case " $READ_ONLY " in
	*" $action "*) ;;
	*)
		[ "$REQUEST_METHOD" = POST ] && [ "${HTTP_X_PICO8OS:-}" = 1 ] || fail post_required
		if [ -n "${HTTP_ORIGIN:-}" ]; then
			case $HTTP_ORIGIN in "http://$HTTP_HOST"|"https://$HTTP_HOST") ;; *) fail bad_origin ;; esac
		fi
		;;
esac

# Login: every action on the admin listener, whatever the Wi-Fi mode.
if [ "$LISTENER" != ap ]; then
	case $action in
	login)
		[ "${CONTENT_LENGTH:-0}" -le 1024 ] || fail too_large
		pw=$(param pw "$(body)")
		auth_lock || fail locked 1
		wait=$(login_wait)
		if [ "$wait" -gt 0 ]; then auth_unlock; fail locked "$wait"; fi
		salt='' hash=''
		read -r salt hash 2>/dev/null < "$RUN/web-auth" || hash=''
		try=$(printf '%s%s' "$salt" "$pw" | sha256sum | cut -d' ' -f1)
		if [ -n "$hash" ] && [ "$try" = "$hash" ]; then
			rm -f "$(ip_file)"; auth_unlock
			sid=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
			: > "$SESS_DIR/$sid"
			printf 'Set-Cookie: sid=%s; Path=/; Max-Age=%s; HttpOnly; Secure; SameSite=Strict\r\n' "$sid" "$SESSION_TTL"
			ok logged_in
		fi
		note_failure; auth_unlock
		sleep 1                     # slow down guessing
		fail bad_password ;;
	logout)
		sid=$(session_id); [ -n "$sid" ] && rm -f "$SESS_DIR/$sid"
		printf 'Set-Cookie: sid=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Strict\r\n'
		ok logged_out ;;
	esac
	check_session || need_login
fi

case $action in
status)
	hdr
	printf '{"lang":%s,' "$(json_str "${LANGUAGE:-en}")"
	printf '"version":%s,"board":%s,"slot":%s,"ip":%s,"wifi":%s,"ap":%s,' \
		"$(json_str "$(os_version)")" "$(json_str "$(os_board)")" "$(json_str "$(current_slot)")" \
		"$(json_str "$(current_ip)")" "$(json_str "$(wifi_state)")" \
		"$([ "$LISTENER" = ap ] && echo true || echo false)"
	printf '"pico8_verify":%s,' "$(json_str "$(cat "$PICO8_DIR.meta/verify" 2>/dev/null)")"
	printf '"pico8":%s,"uptime":%s,"data_free":%s,' \
		"$(json_str "$(pico8_version)")" "$(json_str "$(uptime | sed 's/^.*up *//; s/, *load.*//')")" \
		"$(json_str "$(df -h "$DATA" 2>/dev/null | awk 'NR==2{print $4}')")"
	printf '"ota":{'
	pico8os-ota status 2>/dev/null | awk -F= 'NR>1{printf ","} {v=$0; sub(/^[^=]*=/,"",v); gsub(/\\/,"\\\\",v); gsub(/"/,"\\\"",v); printf "\"%s\":\"%s\"", $1, v}'
	printf '}}\n'
	;;
conf_get)
	hdr text/plain; cat "$DATA/pico8os.txt" 2>/dev/null ;;
conf_put)
	need_post
	[ "${CONTENT_LENGTH:-0}" -le "$MAX_TEXT" ] || fail too_large
	body > "$DATA/pico8os.txt.new" && mv "$DATA/pico8os.txt.new" "$DATA/pico8os.txt" && sync
	priv apply >/dev/null 2>&1
	ok saved ;;
set)
	# k and v from the body (passwords) or the query string
	[ "${CONTENT_LENGTH:-0}" -le 4096 ] || fail too_large
	b=$(body)
	k=$(param k "$b") || k=$(param k) || fail unknown_setting
	v=$(param v "$b") || v=$(param v)
	if has_word "$POLICY_KEYS" "$k"; then
		# root-only policy file: through the agent, which validates it
		priv set_policy "$k" "$v" >/dev/null 2>&1 || fail bad_value "$k"
	elif has_word "$USER_KEYS" "$k"; then
		set_conf "$k" "$v" || fail unknown_setting "$k"
		priv apply "$k" >/dev/null 2>&1
	else
		fail unknown_setting "$k"     # Wi-Fi: wifi_set
	fi
	ok saved_key "$k" ;;
policy)
	hdr
	priv get_policy 2>/dev/null | awk -F= 'BEGIN{printf "{"} NR>1{printf ","} {printf "\"%s\":\"%s\"", $1, $2} END{print "}"}' ;;
carts)
	hdr
	printf '['
	first=1
	for f in "$DATA"/carts/*.p8 "$DATA"/carts/*.p8.png; do
		[ -f "$f" ] || continue
		[ $first = 1 ] || printf ','; first=0
		printf '{"name":%s,"size":%s}' "$(json_str "$(basename "$f")")" "$(stat -c %s "$f")"
	done
	printf ']\n' ;;
cart_put)
	need_post
	n=$(safe_name "$(param name)") || fail bad_name
	case $n in *.p8|*.p8.png) ;; *) fail only_carts ;; esac
	[ "${CONTENT_LENGTH:-0}" -le 1048576 ] || fail too_large
	save_body "$DATA/carts" "$n" || fail upload_failed
	ok uploaded "$n" ;;
cart_del)
	n=$(safe_name "$(param name)") || fail bad_name
	rm -f "$DATA/carts/$n" && sync
	ok deleted "$n" ;;
shots)
	hdr
	ls -t "$DATA/screenshots" 2>/dev/null | grep -i -E '\.(png|gif)$' | json_list; echo ;;
shot)
	n=$(safe_name "$(param name)") || fail bad_name
	f="$DATA/screenshots/$n"
	[ -f "$f" ] || fail bad_name
	case $n in *.png|*.PNG) t=image/png ;; *.gif|*.GIF) t=image/gif ;; *) fail bad_name ;; esac
	printf 'Content-Type: %s\r\nCache-Control: private, max-age=3600\r\n\r\n' "$t"
	cat "$f"; exit 0 ;;
shot_del)
	n=$(safe_name "$(param name)") || fail bad_name
	rm -f "$DATA/screenshots/$n" && sync
	ok deleted "$n" ;;
log)
	case $(param f) in
		pico8) f=$DATA/logs/pico8.log ;; kernel) f=$DATA/logs/kernel.log ;;
		ota) f=$DATA/logs/ota.log ;; bluetooth) f=$DATA/logs/bluetooth.log ;;
		system) hdr text/plain; priv dmesg 2>/dev/null; exit 0 ;;
		*) fail unknown_log ;;
	esac
	hdr text/plain; tail -n 200 "$f" 2>/dev/null ;;
pico8_put)
	need_post
	n=$(safe_name "$(param name)") || fail bad_name
	case $n in pico-8*raspi*.zip) ;; *) fail expect_zip ;; esac
	room_for $((128 * 1048576)) || fail too_large
	save_body "$DATA" "$n" || fail upload_failed
	# the session installs it on start
	priv restart_pico8 >/dev/null 2>&1 || fail restart_failed "$n"
	ok zip_installing "$n" ;;
bt_list)
	hdr
	priv bt_list 2>/dev/null | awk '$1=="Device"{m=$2; $1=""; $2=""; sub(/^  /,""); print m "\t" $0}' | json_list; echo ;;
bt_pair)
	priv_or_fail bt_pair
	ok pairing ;;
bt_remove)
	mac=$(param mac | tr -cd '0-9A-Fa-f:')
	[ ${#mac} -eq 17 ] || fail bad_address
	priv_or_fail bt_remove "$mac"
	ok removed "$mac" ;;
wifi_scan)
	hdr
	if [ "$LISTENER" = ap ]; then cat "$RUN/wifi-scan.txt" 2>/dev/null
	else PRIV_TIMEOUT=20 priv wifi_scan 2>/dev/null; fi | json_list; echo ;;
wifi_set)
	need_post
	[ "${CONTENT_LENGTH:-0}" -le 4096 ] || fail too_large
	b=$(body)
	ssid=$(param ssid "$b") || fail ssid_missing
	psk=$(param psk "$b"); country=$(param country "$b")
	[ -z "$ssid" ] && fail ssid_missing
	[ -n "$psk" ] && { [ ${#psk} -ge 8 ] && [ ${#psk} -le 63 ] || fail psk_len; }
	country=$(printf '%s' "$country" | tr -cd 'A-Za-z' | tr 'a-z' 'A-Z' | head -c 2)
	[ ${#country} = 1 ] && country=
	# stored by the agent in its root-only Wi-Fi file, nowhere else
	priv wifi_set "$ssid" "$psk" "$country" >/dev/null 2>&1 || fail quotes
	ok connecting "$ssid" ;;
ota_put)
	need_post
	room_for $((320 * 1048576)) || fail too_large
	mkdir -p "$DATA/ota"
	save_body "$DATA/ota" upload.pico8os-update || fail upload_failed
	if st=$(PRIV_TIMEOUT=300 priv ota_verify); then
		ok ota "$st"
	else
		rm -f "$DATA/ota/upload.pico8os-update"; fail ota "${st:-error}"
	fi ;;
ota_apply)
	priv ota_apply >/dev/null 2>&1 || fail no_update
	ok installing ;;
ota_check)
	ok ota "$(PRIV_TIMEOUT=60 priv ota_check 2>/dev/null)" ;;
ota_download)
	priv_or_fail ota_download
	ok downloading ;;
ota_rollback)
	ok ota "$(priv ota_rollback 2>/dev/null)" ;;
power)
	case $(param 'do') in
		restart) priv_or_fail restart_pico8; ok restarting ;;
		settings) priv_or_fail restart_pico8 settings; ok settings ;;
		reboot) priv_or_fail reboot; ok rebooting ;;
		poweroff) priv_or_fail poweroff; ok powering_off ;;
		*) fail unknown_action ;;
	esac ;;
*)
	fail unknown_action ;;
esac
