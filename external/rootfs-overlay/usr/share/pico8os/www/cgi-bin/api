#!/bin/sh
# PICO8-OS web API (busybox httpd CGI). /cgi-bin/api?a=ACTION&...
# Uploads are raw request bodies (fetch(url, {method:'POST', body:file})),
# so no multipart parsing is needed.
# Replies carry a message code + argument ({"ok":..,"code":..,"arg":..});
# the page translates api_<code> (and OTA status codes) via i18n.js.
#
# Runs as the unprivileged www user (lighttpd). It reads and writes the data
# partition itself (group www); everything that needs root goes through priv
# (lib.sh) to pico8os-agent, which only runs whitelisted commands.
# Every state change needs POST + "X-Pico8os: 1" (CSRF). Every action needs
# a login session (cookie sid) except "login" itself and Wi-Fi setup (AP)
# mode; failed logins lock the client out for growing periods.
. /usr/lib/pico8os/lib.sh
load_config

MAX_TEXT=65536

hdr() { printf 'Content-Type: %s\r\nCache-Control: no-store\r\n\r\n' "${1:-application/json}"; }
# ok|fail CODE [ARG]
reply() {
	hdr
	printf '{"ok":%s,"code":%s,"arg":%s}\n' "$1" "$(json_str "$2")" "$(json_str "${3:-}")"
	exit 0
}
ok() { reply true "$1" "${2:-}"; }
fail() { printf 'Status: 400 Bad Request\r\n'; reply false "$1" "${2:-}"; }
# OTA results: the code is "ota", the argument the OTA status line.
ota_reply() { "$1" ota "$(cat "$RUN/ota.status" 2>/dev/null)"; }
need_login() { printf 'Status: 401 Unauthorized\r\n'; reply false login_required; }

# ---- sessions and login rate limiting ----
SESS_DIR="$RUN/sessions"; AUTH_DIR="$RUN/auth"; SESSION_TTL=43200
now=$(date +%s)
session_id() {
	printf '%s' "${HTTP_COOKIE:-}" | tr ';' '\n' | sed -n 's/^ *sid=\([0-9a-f]\{48\}\)$/\1/p' | head -n 1
}
check_session() {
	sid=$(session_id)
	[ -n "$sid" ] && [ -f "$SESS_DIR/$sid" ] || return 1
	if [ $(( now - $(stat -c %Y "$SESS_DIR/$sid") )) -ge $SESSION_TTL ]; then
		rm -f "$SESS_DIR/$sid"; return 1
	fi
	touch "$SESS_DIR/$sid"
}
# lockout state "<failures> <locked-until>" per client address and globally
ip_file() { printf '%s/%s' "$AUTH_DIR" "$(printf '%s' "${REMOTE_ADDR:-unknown}" | tr -c '0-9A-Fa-f' '_')"; }
locked_for() { # FILE -> seconds still locked (0 = free)
	set -- $(cat "$1" 2>/dev/null) 0 0
	[ "$2" -gt "$now" ] && echo $(( $2 - now )) || echo 0
}
note_failure() { # FILE THRESHOLD: lock 60 s after THRESHOLD failures, doubling, max 1 h
	set -- "$1" "$2" $(cat "$1" 2>/dev/null) 0 0
	f=$(( $3 + 1 )) until=$4
	if [ $f -ge "$2" ]; then
		d=$(( 60 << (f - $2) )); [ $d -gt 3600 ] && d=3600
		until=$(( now + d ))
	fi
	echo "$f $until" > "$1"
}

# priv_or_fail CMD...: run a privileged action; the request fails with it
priv_or_fail() { priv "$@" >/dev/null 2>&1 || fail unknown_action; }

urldecode() {
	printf '%b' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/+/ /g' \
		-e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}
# param NAME [STRING]: value of NAME in STRING (default: the query string)
param() {
	src=${2-$QUERY_STRING}
	old_ifs=$IFS; IFS='&'
	for kv in $src; do
		case $kv in "$1="*) IFS=$old_ifs; urldecode "${kv#*=}"; return 0 ;; esac
	done
	IFS=$old_ifs
	return 1
}
body() { head -c "${CONTENT_LENGTH:-0}"; }
need_post() { [ "$REQUEST_METHOD" = POST ] || fail post_required; }  # (also enforced globally below)

# File names from the browser: one path component, no hidden files.
safe_name() {
	n=$(printf '%s' "$1" | tr -d '/\\\r\n' | tr -c 'A-Za-z0-9._ ()+-' '_')
	case $n in ''|.*) return 1 ;; esac
	printf '%s' "$n"
}

json_list() { # lines on stdin -> JSON array of strings
	first=1; printf '['
	while IFS= read -r l; do
		[ $first = 1 ] || printf ','; first=0
		json_str "$l"
	done
	printf ']'
}

pico8_version() {
	v=$(grep -m1 -o 'PICO-8 v[0-9][0-9.a-z]*' "$PICO8_DIR/pico-8_manual.txt" 2>/dev/null)
	if [ -n "$v" ]; then echo "${v#PICO-8 }"
	elif is_installed; then echo "@installed"
	else echo "@none"
	fi
}

wifi_state() {
	if [ -f "$RUN/ap-mode" ]; then echo "ap:$(cat "$RUN/ap-ssid" 2>/dev/null)"
	elif s=$(iw dev wlan0 link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p') && [ -n "$s" ]; then echo "on:$s"
	elif [ -e /sys/class/net/wlan0 ]; then echo "off"
	else echo "none"
	fi
}

AP_ONLY="status wifi_scan wifi_set"
READ_ONLY="status conf_get carts shots shot log bt_list wifi_scan"
action=$(param a) || action=status
if [ -f "$RUN/ap-mode" ]; then
	case " $AP_ONLY " in *" $action "*) ;; *) fail ap_only ;; esac
else
	# DNS rebinding: only answer for the console's own address or name.
	host=${HTTP_HOST%:*}
	case $host in
		''|localhost|pico8os|pico8os.local) ;;
		\[*\]) ;;                       # IPv6 literal
		*[!0-9.]*) fail bad_origin ;;   # not an IPv4 literal
	esac
fi
# CSRF: anything that changes state must be a POST carrying X-Pico8os: 1
# (a custom header a foreign web page cannot send without a CORS preflight,
# which this server never grants) and, if the browser sends one, a matching
# Origin. Read-only actions may be GET.
case " $READ_ONLY " in
	*" $action "*) ;;
	*)
		[ "$REQUEST_METHOD" = POST ] && [ "${HTTP_X_PICO8OS:-}" = 1 ] || fail post_required
		if [ -n "${HTTP_ORIGIN:-}" ]; then
			case $HTTP_ORIGIN in "http://$HTTP_HOST"|"https://$HTTP_HOST") ;; *) fail bad_origin ;; esac
		fi
		;;
esac

# Login (not in Wi-Fi setup mode, where only Wi-Fi actions exist).
if [ ! -f "$RUN/ap-mode" ]; then
	case $action in
	login)
		ipf=$(ip_file); glob="$AUTH_DIR/_all"
		wait=$(locked_for "$ipf"); gw=$(locked_for "$glob")
		[ "$gw" -gt "$wait" ] && wait=$gw
		[ "$wait" -gt 0 ] && fail locked "$wait"
		[ "${CONTENT_LENGTH:-0}" -le 1024 ] || fail too_large
		pw=$(param pw "$(body)")
		set -- $(cat "$RUN/web-auth" 2>/dev/null)
		try=$(printf '%s%s' "${1:-}" "$pw" | sha256sum | cut -d' ' -f1)
		if [ -n "${2:-}" ] && [ "$try" = "$2" ]; then
			rm -f "$ipf"
			sid=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
			: > "$SESS_DIR/$sid"
			printf 'Set-Cookie: sid=%s; Path=/; Max-Age=%s; HttpOnly; Secure; SameSite=Strict\r\n' "$sid" "$SESSION_TTL"
			ok logged_in
		fi
		note_failure "$ipf" 5       # per client: 5 tries
		note_failure "$glob" 20     # everyone together: 20 tries
		sleep 1                     # slow down guessing
		fail bad_password ;;
	logout)
		sid=$(session_id); [ -n "$sid" ] && rm -f "$SESS_DIR/$sid"
		printf 'Set-Cookie: sid=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Strict\r\n'
		ok logged_out ;;
	esac
	check_session || need_login
fi

case $action in
status)
	hdr
	printf '{"lang":%s,' "$(json_str "${LANGUAGE:-en}")"
	printf '"version":%s,"board":%s,"slot":%s,"ip":%s,"wifi":%s,"ap":%s,' \
		"$(json_str "$(os_version)")" "$(json_str "$(os_board)")" "$(json_str "$(current_slot)")" \
		"$(json_str "$(current_ip)")" "$(json_str "$(wifi_state)")" \
		"$([ -f "$RUN/ap-mode" ] && echo true || echo false)"
	printf '"pico8_verify":%s,' "$(json_str "$(cat "$PICO8_DIR/.verify" 2>/dev/null)")"
	printf '"pico8":%s,"uptime":%s,"data_free":%s,' \
		"$(json_str "$(pico8_version)")" "$(json_str "$(uptime | sed 's/^.*up *//; s/, *load.*//')")" \
		"$(json_str "$(df -h "$DATA" 2>/dev/null | awk 'NR==2{print $4}')")"
	printf '"ota":{'
	pico8os-ota status 2>/dev/null | awk -F= 'NR>1{printf ","} {v=$0; sub(/^[^=]*=/,"",v); gsub(/\\/,"\\\\",v); gsub(/"/,"\\\"",v); printf "\"%s\":\"%s\"", $1, v}'
	printf '}}\n'
	;;
conf_get)
	hdr text/plain; cat "$DATA/pico8os.txt" 2>/dev/null ;;
conf_put)
	need_post
	[ "${CONTENT_LENGTH:-0}" -le "$MAX_TEXT" ] || fail too_large
	body > "$DATA/pico8os.txt.new" && mv "$DATA/pico8os.txt.new" "$DATA/pico8os.txt" && sync
	priv apply >/dev/null 2>&1
	ok saved ;;
set)
	k=$(param k) || fail unknown_setting; v=$(param v)
	set_conf "$k" "$v" || fail unknown_setting "$k"
	priv apply "$k" >/dev/null 2>&1
	ok saved_key "$k" ;;
carts)
	hdr
	printf '['
	first=1
	for f in "$DATA"/carts/*.p8 "$DATA"/carts/*.p8.png; do
		[ -f "$f" ] || continue
		[ $first = 1 ] || printf ','; first=0
		printf '{"name":%s,"size":%s}' "$(json_str "$(basename "$f")")" "$(stat -c %s "$f")"
	done
	printf ']\n' ;;
cart_put)
	need_post
	n=$(safe_name "$(param name)") || fail bad_name
	case $n in *.p8|*.p8.png) ;; *) fail only_carts ;; esac
	[ "${CONTENT_LENGTH:-0}" -le 1048576 ] || fail too_large
	body > "$DATA/carts/.$n.part" && mv "$DATA/carts/.$n.part" "$DATA/carts/$n" && sync
	ok uploaded "$n" ;;
cart_del)
	n=$(safe_name "$(param name)") || fail bad_name
	rm -f "$DATA/carts/$n" && sync
	ok deleted "$n" ;;
shots)
	hdr
	ls -t "$DATA/screenshots" 2>/dev/null | grep -i -E '\.(png|gif)$' | json_list; echo ;;
shot)
	n=$(safe_name "$(param name)") || fail bad_name
	f="$DATA/screenshots/$n"
	[ -f "$f" ] || fail bad_name
	case $n in *.png|*.PNG) t=image/png ;; *.gif|*.GIF) t=image/gif ;; *) fail bad_name ;; esac
	printf 'Content-Type: %s\r\nCache-Control: private, max-age=3600\r\n\r\n' "$t"
	cat "$f"; exit 0 ;;
shot_del)
	n=$(safe_name "$(param name)") || fail bad_name
	rm -f "$DATA/screenshots/$n" && sync
	ok deleted "$n" ;;
log)
	case $(param f) in
		pico8) f=$DATA/logs/pico8.log ;; kernel) f=$DATA/logs/kernel.log ;;
		ota) f=$DATA/logs/ota.log ;; bluetooth) f=$DATA/logs/bluetooth.log ;;
		system) hdr text/plain; priv dmesg 2>/dev/null; exit 0 ;;
		*) fail unknown_log ;;
	esac
	hdr text/plain; tail -n 200 "$f" 2>/dev/null ;;
pico8_put)
	need_post
	n=$(safe_name "$(param name)") || fail bad_name
	case $n in pico-8*raspi*.zip) ;; *) fail expect_zip ;; esac
	body > "$DATA/.$n.part" && mv "$DATA/.$n.part" "$DATA/$n" && sync
	priv restart_pico8 >/dev/null 2>&1   # the session installs it on start
	ok zip_installing "$n" ;;
bt_list)
	hdr
	priv bt_list 2>/dev/null | awk '$1=="Device"{m=$2; $1=""; $2=""; sub(/^  /,""); print m "\t" $0}' | json_list; echo ;;
bt_pair)
	priv_or_fail bt_pair
	ok pairing ;;
bt_remove)
	mac=$(param mac | tr -cd '0-9A-Fa-f:')
	[ ${#mac} -eq 17 ] || fail bad_address
	priv_or_fail bt_remove "$mac"
	ok removed "$mac" ;;
wifi_scan)
	hdr
	if [ -f "$RUN/ap-mode" ]; then cat "$RUN/wifi-scan.txt" 2>/dev/null
	else PRIV_TIMEOUT=20 priv wifi_scan 2>/dev/null; fi | json_list; echo ;;
wifi_set)
	need_post
	[ "${CONTENT_LENGTH:-0}" -le 4096 ] || fail too_large
	b=$(body)
	ssid=$(param ssid "$b") || fail ssid_missing
	psk=$(param psk "$b"); country=$(param country "$b")
	[ -z "$ssid" ] && fail ssid_missing
	[ -n "$psk" ] && { [ ${#psk} -ge 8 ] && [ ${#psk} -le 63 ] || fail psk_len; }
	set_conf WIFI_SSID "$ssid" && set_conf WIFI_PSK "$psk" || fail quotes
	[ -n "$country" ] && set_conf WIFI_COUNTRY "$(printf '%s' "$country" | tr -cd 'A-Za-z' | tr 'a-z' 'A-Z' | head -c 2)"
	priv wifi_restart >/dev/null 2>&1
	ok connecting "$ssid" ;;
ota_put)
	need_post
	mkdir -p "$DATA/ota"
	body > "$DATA/ota/upload.pico8os-update.part" || fail upload_failed
	mv "$DATA/ota/upload.pico8os-update.part" "$DATA/ota/upload.pico8os-update"; sync
	if st=$(PRIV_TIMEOUT=300 priv ota_verify); then
		ok ota "$st"
	else
		rm -f "$DATA/ota/upload.pico8os-update"; fail ota "${st:-error}"
	fi ;;
ota_apply)
	priv ota_apply >/dev/null 2>&1 || fail no_update
	ok installing ;;
ota_check)
	ok ota "$(PRIV_TIMEOUT=60 priv ota_check 2>/dev/null)" ;;
ota_download)
	priv_or_fail ota_download
	ok downloading ;;
ota_rollback)
	ok ota "$(priv ota_rollback 2>/dev/null)" ;;
power)
	case $(param do) in
		restart) priv_or_fail restart_pico8; ok restarting ;;
		settings) priv_or_fail restart_pico8 settings; ok settings ;;
		reboot) priv_or_fail reboot; ok rebooting ;;
		poweroff) priv_or_fail poweroff; ok powering_off ;;
		*) fail unknown_action ;;
	esac ;;
*)
	fail unknown_action ;;
esac
