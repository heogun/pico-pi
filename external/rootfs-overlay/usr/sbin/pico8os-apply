#!/bin/sh
# Apply settings changed at runtime (web UI / settings cart).
#   pico8os-apply [KEY...]   (no keys = everything)
. /usr/lib/pico8os/lib.sh
load_config
all=${1:-all}
# Callers pass shell patterns such as WIFI_*.
# shellcheck disable=SC2254
need() { [ "$all" = all ] && return 0; for k in $KEYS; do case $k in $1) return 0 ;; esac; done; return 1; }
KEYS="$*"
if need 'WIFI_*'; then pico8os-wifi restart >/dev/null 2>&1 & fi
if need 'WEB_PASSWORD'; then (sleep 1; pico8os-web restart) >/dev/null 2>&1 & fi
if need 'BLUETOOTH'; then
	if [ "$BLUETOOTH" = off ]; then bluetoothctl power off; else bluetoothctl power on; fi >/dev/null 2>&1
fi
if need 'HOTKEY'; then
	killall pico8-hotkey 2>/dev/null
	[ "$HOTKEY" = off ] || pico8-hotkey
fi
if need 'KEYMAP' || need 'PICO8_*' || need 'EXIT_ACTION' || need 'AUDIO_CARD' || need 'VIDEO_DRIVER'; then
	restart_pico8
fi
exit 0
