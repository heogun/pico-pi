#!/bin/sh
# PICO8-OS Wi-Fi: client mode from pico8os.txt, or a setup access point.
#   pico8os-wifi start|stop|restart   bring Wi-Fi up (background-safe)
#   pico8os-wifi scan                 list nearby network names
#
# No network configured (or it cannot be joined within 40 s) and no wired
# connection -> WPA2 access point "PICO8-OS-xxxx" at 192.168.4.1; its
# password is in the settings cart (Ctrl+Alt+S / SELECT 2 s) and in
# PICO8DATA/wifi-setup.txt. Every web address on it shows the Wi-Fi setup
# page (captive portal); after the network is saved the console leaves AP
# mode and joins it. While in AP mode with a network configured, joining it
# is retried every 5 minutes; with no client for 30 minutes the AP turns off.
. /usr/lib/pico8os/lib.sh
load_config
IF=wlan0
AP_IP=192.168.4.1
LOG="$DATA/logs/wifi.log"

log() { mkdir -p "$DATA/logs"; echo "$(date '+%F %T') $*" >> "$LOG"; }
has_if() { [ -e /sys/class/net/$IF ]; }
has_ip() { ip -4 -o addr show dev "$1" scope global 2>/dev/null | grep -q inet; }
wired_up() { [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" = 1 ] && has_ip eth0; }

stop_all() {
	killall hostapd dnsmasq wpa_supplicant 2>/dev/null
	kill "$(cat "$RUN/udhcpc-$IF.pid" 2>/dev/null)" 2>/dev/null
	sleep 0.5
	ip addr flush dev $IF 2>/dev/null
	rm -f "$RUN/ap-mode" "$RUN/ap-ssid"
}

# Only two capital letters are a country code (also used in hostapd.conf).
case $WIFI_COUNTRY in [A-Z][A-Z]) ;; *) WIFI_COUNTRY= ;; esac

# The network name goes in as hex and the passphrase only as the derived
# 256-bit key, so neither can add lines to the configuration.
hex() { printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n'; }
client() {
	conf="$RUN/wpa_supplicant.conf"
	umask 077
	{
		echo "ctrl_interface=/var/run/wpa_supplicant"
		[ -n "$WIFI_COUNTRY" ] && echo "country=$WIFI_COUNTRY"
		echo "network={"
		printf '\tssid=%s\n' "$(hex "$WIFI_SSID")"
		if [ -n "$WIFI_PSK" ]; then
			key=$(wpa_passphrase "$WIFI_SSID" "$WIFI_PSK" | sed -n 's/^[[:space:]]*psk=\([0-9a-f]\{64\}\)$/\1/p')
			[ -n "$key" ] || { umask 022; log "invalid Wi-Fi passphrase"; return 1; }
			printf '\tpsk=%s\n' "$key"
		else
			printf '\tkey_mgmt=NONE\n'
		fi
		echo "}"
	} > "$conf"
	umask 022
	ip link set $IF up
	wpa_supplicant -B -i $IF -c "$conf" >/dev/null 2>&1
	udhcpc -b -i $IF -p "$RUN/udhcpc-$IF.pid" >/dev/null 2>&1
	i=0
	while [ $i -lt 40 ]; do has_ip $IF && { log "joined $WIFI_SSID ($(current_ip))"; return 0; }; sleep 1; i=$((i + 1)); done
	log "could not join $WIFI_SSID"
	return 1
}

scan() {
	ip link set $IF up 2>/dev/null
	iw dev $IF scan 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p' | grep -v '^$' | sort -u > "$RUN/wifi-scan.new" \
		&& [ -s "$RUN/wifi-scan.new" ] && mv "$RUN/wifi-scan.new" "$RUN/wifi-scan.txt"
	cat "$RUN/wifi-scan.txt" 2>/dev/null
}

ap() {
	scan >/dev/null      # remember nearby networks for the setup page
	stop_all
	mac=$(tr -d ':' < /sys/class/net/$IF/address | tail -c 5 | tr 'a-f' 'A-F')
	ssid="PICO8-OS-$mac"
	cat > "$RUN/hostapd.conf" <<CONF
interface=$IF
driver=nl80211
ssid=$ssid
hw_mode=g
channel=6
country_code=${WIFI_COUNTRY:-US}
auth_algs=1
wmm_enabled=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=$(ap_password)
CONF
	chmod 600 "$RUN/hostapd.conf"
	ip link set $IF up
	ip addr add $AP_IP/24 dev $IF
	hostapd -B "$RUN/hostapd.conf" >/dev/null 2>&1 || { log "hostapd failed"; return 1; }
	dnsmasq --interface=$IF --bind-interfaces --no-resolv --no-hosts \
		--dhcp-range=192.168.4.10,192.168.4.60,10m --dhcp-option=3,$AP_IP --dhcp-option=6,$AP_IP \
		--address=/#/$AP_IP --pid-file="$RUN/dnsmasq.pid"
	echo "$ssid" > "$RUN/ap-ssid"
	touch "$RUN/ap-mode"
	printf 'PICO8-OS Wi-Fi setup network\r\nName:     %s\r\nPassword: %s\r\nThen open http://192.168.4.1\r\n' \
		"$ssid" "$(ap_password)" > "$DATA/wifi-setup.txt"; sync
	pico8os-web restart
	log "setup access point $ssid on $AP_IP"
	# Retry the configured network now and then, unless someone is connected;
	# turn the AP off after 30 minutes without any client.
	(
		idle=0
		while [ -f "$RUN/ap-mode" ]; do
			sleep 300
			[ -f "$RUN/ap-mode" ] || exit 0
			if [ -n "$(iw dev $IF station dump 2>/dev/null)" ]; then idle=0; continue; fi
			idle=$((idle + 5))
			load_config
			[ -n "$WIFI_SSID" ] && exec pico8os-wifi restart
			if [ $idle -ge 30 ]; then
				log "setup access point off after 30 minutes without a client"
				exec pico8os-wifi stop
			fi
		done
	) >/dev/null 2>&1 &
}

start() {
	has_if || exit 0
	mkdir -p "$RUN"
	if [ -n "$WIFI_SSID" ] && client; then
		pico8os-web restart; return 0
	fi
	sleep 5   # give a cable a moment to get an address
	if wired_up; then
		log "wired network up; no setup access point"
		killall wpa_supplicant 2>/dev/null
		return 0
	fi
	ap
}

case ${1:-} in
	start) start ;;
	stop) stop_all; pico8os-web restart ;;
	restart) stop_all; start ;;
	scan) if [ -f "$RUN/ap-mode" ]; then cat "$RUN/wifi-scan.txt" 2>/dev/null; else scan; fi ;;
	*) echo "usage: $0 start|stop|restart|scan" >&2; exit 2 ;;
esac
