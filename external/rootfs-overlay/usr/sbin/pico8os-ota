#!/bin/sh
# PICO8-OS OTA updates: A/B system slots, signed bundles, automatic rollback.
#
#   pico8os-ota status              print state (key=value)
#   pico8os-ota verify FILE         check signature, board and payload hashes
#   pico8os-ota apply FILE          verify, write the inactive slot, switch to it
#   pico8os-ota check               ask OTA_URL/latest-<board>.txt for a newer version
#   pico8os-ota download            download it to /data/ota/ (then: apply)
#   pico8os-ota boot-check          early boot: count tries of a new slot, roll back
#                                   (exit 3: rebooting now)
#   pico8os-ota mark-good           the new slot works: make it permanent
#   pico8os-ota rollback            boot the other slot (if it is installed) or
#                                   cancel an update that waits for a reboot
#   pico8os-ota reboot              reboot; into a new slot on trial if one waits
#
# A slot can be booted only while its boot files are complete
# (/boot/<slot>/cmdline.txt). They are removed before the slot is written
# and put back (rename of <slot>.new) only after the written root
# filesystem was read back and matched the signed hash; a slot that failed
# its boot tries loses them too. slot.txt never points at a slot without
# them.
#
# Two ways to start a new slot:
#   try   (Raspberry Pi: pico8os-tryboot and "include slot.txt" in
#         config.txt) slot.txt keeps naming the running slot. tryslot.txt
#         names the new one and tryboot.txt is config.txt with
#         "include tryslot.txt". "pico8os-ota reboot" sets the firmware's
#         one-shot tryboot flag, so only that one boot uses the new slot: if
#         it hangs anywhere (firmware, kernel, init), a reset or the
#         watchdog boots the old slot. mark-good then writes slot.txt. Back
#         on the old slot after a try, boot-check tries again, up to
#         MAX_TRIES, then gives the update up.
#   flip  (QEMU, other boards) slot.txt names the new slot at once and
#         boot-check counts its boots, rolling back after MAX_TRIES. A slot
#         that stops before init is not counted there.
#
# Bundle (tar): manifest, manifest.sig (ECDSA P-256 over manifest),
# cmdline.txt.in, boot.tar.gz (kernel, DTBs, overlays), rootfs.ext4.gz.
# The manifest holds the sha256 of each member and of the uncompressed root
# filesystem (rootfs_raw_sha256), which is checked on the written slot.
# Switching slots rewrites one line on the boot partition: slot.txt
# ("os_prefix=a/" or "os_prefix=b/"), read by the Pi firmware.
#
# Progress ($RUN/ota.status) is "<code> [args]" so the web UI and the
# settings cart can show it in their language:
#   verifying | checking | writing VER SLOT | kernel SLOT | ready VER
#   valid VER | updated VER | uptodate VER | available VER | downloading VER
#   rolledback | error CODE [args]   (CODE: nofile notupdate unsigned badsig
#   format board older corrupt nofit write bootmount bootfiles nourl
#   unreachable badlatest download toolarge nospace busy verifywrite noslot
#   state bootfailed)
. /usr/lib/pico8os/lib.sh
load_config

PUBKEY=${PUBKEY:-/etc/pico8os/ota-public.pem}
STATE=${STATE:-/state/ota}
STATUS="$RUN/ota.status"
LOG="$DATA/logs/ota.log"
MAX_TRIES=3

log() { mkdir -p "$DATA/logs"; echo "$(date '+%F %T') $*" >> "$LOG"; }
progress() { mkdir -p "$RUN"; printf '%s\n' "$*" > "$STATUS"; log "$*"; }
die() { progress "error $*"; echo "pico8os-ota: error $*" >&2; exit 1; }   # cleanup: trap

mount_boot() {
	mkdir -p /boot
	mountpoint -q /boot && return 0
	mount -t vfat -o rw,noatime,flush "$(disk_prefix)1" /boot
}
umount_boot() { sync; umount /boot 2>/dev/null; }

# With /boot mounted:
slot_bootable() { [ -f "/boot/$1/cmdline.txt" ]; }
boot_target() { sed -n 's#^os_prefix=\([ab]\)/$#\1#p' /boot/slot.txt 2>/dev/null | head -n 1; }
# write_slot SLOT: atomic-ish flip (write slot.txt.new, rename over
# slot.txt), only to a slot that can boot.
write_slot() {
	slot_bootable "$1" || return 1
	[ "$(boot_target)" = "$1" ] && return 0
	echo "os_prefix=$1/" > /boot/slot.txt.new && sync && mv /boot/slot.txt.new /boot/slot.txt && sync
}
# unboot_slot SLOT: remove its boot files (never the slot slot.txt names).
unboot_slot() {
	[ "$(boot_target)" != "$1" ] || return 1
	rm -rf "/boot/$1.new" "/boot/$1.bad"
	[ -e "/boot/$1" ] && { mv "/boot/$1" "/boot/$1.bad" && rm -rf "/boot/$1.bad" || return 1; }
	sync
}

# pending_write SLOT PREVIOUS VERSION TRIES [MODE]: rewrite + rename, so a power
# cut never leaves a half-written state. Fails unless every step worked and
# the file reads back with this slot and count (a full /state or an I/O
# error must not pass as saved: without it the boots are not counted).
pending_write() {
	mkdir -p "$STATE" \
		&& printf 'slot=%s\nprevious=%s\nversion=%s\ntries=%s\nmode=%s\n' "$1" "$2" "$3" "$4" "${5:-flip}" > "$STATE/pending.new" \
		&& sync && mv -f "$STATE/pending.new" "$STATE/pending" && sync \
		|| { rm -f "$STATE/pending.new"; return 1; }
	[ "$(manifest_get slot "$STATE/pending")" = "$1" ] && [ "$(manifest_get tries "$STATE/pending")" = "$4" ]
}
# pending_clear: forget the pending update; fails if the file is still there.
pending_clear() { rm -f "$STATE/pending"; sync; [ ! -e "$STATE/pending" ]; }

manifest_get() { sed -n "s/^$1=//p" "$2" | head -n 1; }

# ---- firmware tryboot (with /boot mounted) ----
TRYBOOT=${TRYBOOT:-/usr/sbin/pico8os-tryboot}
# tryboot_capable: this board can boot a slot once (see "try" above).
tryboot_capable() {
	[ -x "$TRYBOOT" ] && [ -c "${VCIO:-/dev/vcio}" ] \
		&& tr -d '\r' < /boot/config.txt 2>/dev/null | grep -qx 'include slot.txt'
}
# tryboot_files SLOT: tryboot.txt from the current config.txt (so later
# edits of config.txt carry over) and tryslot.txt naming SLOT, which must be
# bootable. Both written to a new name and renamed.
tryboot_files() {
	slot_bootable "$1" || return 1
	tr -d '\r' < /boot/config.txt | sed 's#^include slot\.txt$#include tryslot.txt#' > /boot/tryboot.txt.new \
		&& grep -qx 'include tryslot.txt' /boot/tryboot.txt.new \
		&& echo "os_prefix=$1/" > /boot/tryslot.txt.new && sync \
		&& mv -f /boot/tryboot.txt.new /boot/tryboot.txt && mv -f /boot/tryslot.txt.new /boot/tryslot.txt && sync \
		|| { rm -f /boot/tryboot.txt.new /boot/tryslot.txt.new; return 1; }
}
# tryboot_disarm: a tryboot flag left set (an update given up or replaced)
# must boot what slot.txt names: clear it and point tryslot.txt there.
tryboot_disarm() {
	[ -x "$TRYBOOT" ] && "$TRYBOOT" clear >/dev/null 2>&1
	if [ -f /boot/tryslot.txt ]; then
		t=$(boot_target)
		[ -n "$t" ] && echo "os_prefix=$t/" > /boot/tryslot.txt.new && mv -f /boot/tryslot.txt.new /boot/tryslot.txt
		sync
	fi
	return 0
}

# ---- limits and locking ----
OTA_LOCK="$RUN/ota.lock"
BOOT_MAX_MB=64          # boot.tar.gz (kernel, DTBs, overlays)
SMALL_MAX=65536         # manifest, signature, cmdline.txt.in, latest.txt
DATA_RESERVE_MB=32      # keep this much of PICO8DATA free when downloading

# One OTA operation at a time (web UI, settings cart and boot can all start
# one): flock on fd 9, released by the kernel when the process ends, so a
# crashed run never leaves a stale lock. "wait" blocks instead of failing.
ota_lock() {
	[ -n "${OTA_LOCKED:-}" ] && return 0    # held already (boot-check -> reboot)
	mkdir -p "$RUN"
	exec 9> "$OTA_LOCK" || die busy
	if [ "${1:-}" = wait ]; then flock 9 || die busy; else flock -n 9 || die busy; fi
	OTA_LOCKED=1
}
cleanup() {
	[ -n "${WORK:-}" ] && { umount "$WORK" 2>/dev/null; rm -rf "$WORK"; }
	WORK=
}
trap cleanup EXIT
trap 'exit 1' INT TERM

# Root-only scratch space in RAM, size-limited: the private copies of the
# small payloads live here, never on the user-writable data partition.
work_new() {
	mkdir -p "$RUN"
	WORK=$(mktemp -d "$RUN/ota.XXXXXX") || die write
	chmod 700 "$WORK"
	mount -t tmpfs -o "size=$((BOOT_MAX_MB + 1))m,mode=0700,nosuid,nodev,noexec" tmpfs "$WORK" 2>/dev/null \
		|| [ -n "${OTA_NO_TMPFS:-}" ] || die write
}

target_part() { slot_part "$(other_slot "$(current_slot)")"; }
part_bytes() { echo $(( $(cat "/sys/class/block/${1#/dev/}/size" 2>/dev/null || echo 0) * 512 )); }
# Largest bundle that can be valid: a full slot plus the boot files.
max_bundle() { echo $(( $(part_bytes "$(target_part)") + (BOOT_MAX_MB + 1) * 1048576 )); }
file_bytes() { stat -c %s "$1" 2>/dev/null || echo 0; }

# member BUNDLE NAME MAXBYTES OUT: private copy of one bundle member,
# refused if larger than MAXBYTES.
member() {
	tar -xOf "$1" "$2" 2>/dev/null | head -c $(( $3 + 1 )) > "$4" || return 1
	[ -s "$4" ] && [ "$(file_bytes "$4")" -le "$3" ]
}
sha_of() { sha256sum "$1" | cut -d' ' -f1; }
is_sha() { case $1 in *[!0-9a-f]*) return 1 ;; esac; [ ${#1} = 64 ]; }

# verify FILE [full]: check the signed manifest and take private, checked
# copies of the small payloads into $WORK (manifest, cmdline.txt.in,
# boot.tar.gz). Everything installed afterwards comes from these copies or,
# for the root filesystem, is read back from the slot and compared with the
# signed hash before the slot is used. "full" also hashes rootfs.ext4.gz in
# the bundle, for an early answer on upload.
verify() {
	f=$1
	[ -f "$f" ] && [ ! -L "$f" ] || die nofile
	[ "$(file_bytes "$f")" -le "$(max_bundle)" ] || die toolarge
	work_new
	member "$f" manifest $SMALL_MAX "$WORK/manifest" || die notupdate
	member "$f" manifest.sig 1024 "$WORK/manifest.sig" || die unsigned
	openssl dgst -sha256 -verify "$PUBKEY" -signature "$WORK/manifest.sig" "$WORK/manifest" >/dev/null 2>&1 \
		|| die badsig
	[ "$(manifest_get format "$WORK/manifest")" = 1 ] || die format
	b=$(manifest_get board "$WORK/manifest")
	[ "$b" = "$(os_board)" ] || die board "$b" "$(os_board)"
	# No downgrades: an old (correctly signed) bundle could bring back fixed
	# vulnerabilities. Going back to the previous system is "rollback".
	v=$(manifest_get version "$WORK/manifest")
	[ "$v" \> "$(os_version)" ] || die older "$v" "$(os_version)"
	progress checking
	size=$(manifest_get rootfs_size "$WORK/manifest")
	case $size in ''|*[!0-9]*) die format ;; esac
	is_sha "$(manifest_get rootfs_raw_sha256 "$WORK/manifest")" || die format
	[ "$size" -le "$(part_bytes "$(target_part)")" ] || die nofit
	member "$f" cmdline.txt.in 4096 "$WORK/cmdline.txt.in" || die corrupt cmdline.txt.in
	[ "$(sha_of "$WORK/cmdline.txt.in")" = "$(manifest_get cmdline_sha256 "$WORK/manifest")" ] || die corrupt cmdline.txt.in
	member "$f" boot.tar.gz $((BOOT_MAX_MB * 1048576)) "$WORK/boot.tar.gz" || die corrupt boot.tar.gz
	[ "$(sha_of "$WORK/boot.tar.gz")" = "$(manifest_get boot_sha256 "$WORK/manifest")" ] || die corrupt boot.tar.gz
	if [ "${2:-}" = full ]; then
		got=$(tar -xOf "$f" rootfs.ext4.gz | sha256sum | cut -d' ' -f1)
		[ "$got" = "$(manifest_get rootfs_sha256 "$WORK/manifest")" ] || die corrupt rootfs.ext4.gz
	fi
}

# write_rootfs BUNDLE PART: stream the root filesystem into the inactive
# slot, then drop the page cache and read the slot back: only if its first
# rootfs_size bytes match the signed rootfs_raw_sha256 is the slot used.
# (A bundle changed while it is read can only leave a slot that fails this
# check and is never booted.)
write_rootfs() {
	size=$(manifest_get rootfs_size "$WORK/manifest")
	want=$(manifest_get rootfs_raw_sha256 "$WORK/manifest")
	rm -f "$WORK"/rc.*
	{ tar -xOf "$1" rootfs.ext4.gz; echo $? > "$WORK/rc.tar"; } \
		| { gzip -dc; echo $? > "$WORK/rc.gzip"; } \
		| { head -c "$size"; echo $? > "$WORK/rc.head"; } \
		| { dd of="$2" bs=1M conv=fsync 2>/dev/null; echo $? > "$WORK/rc.dd"; }
	for s in tar gzip head dd; do
		[ "$(cat "$WORK/rc.$s" 2>/dev/null)" = 0 ] || die write "$2"
	done
	sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
	got=$(head -c "$size" "$2" | sha256sum | cut -d' ' -f1)
	[ "$got" = "$want" ] || die verifywrite "$2"
}

apply() {
	f=$1
	ota_lock
	cur=$(current_slot); new=$(other_slot "$cur"); part=$(slot_part "$new")
	# The running slot is still on trial (not marked good yet): the other
	# slot is the way back, never overwrite it now.
	if [ -f "$STATE/pending" ] && [ "$(manifest_get slot "$STATE/pending")" = "$cur" ]; then
		die busy
	fi
	# The boot tries of the new slot are counted in $STATE/pending: with
	# /state on the RAM fallback (picostate not mounted) they would be lost
	# at the reboot, so no update is installed then.
	state_is_persistent || die state
	progress verifying
	verify "$f"
	ver=$(manifest_get version "$WORK/manifest")
	# Before the target slot is touched: the running slot boots next
	# whatever happens, and the target cannot be booted (its boot files go,
	# a scheduled update into it is forgotten) until it is written and
	# checked.
	mount_boot || die bootmount
	{ write_slot "$cur" && tryboot_disarm && unboot_slot "$new"; } || { umount_boot; die bootfiles; }
	umount_boot
	pending_clear || die state
	progress writing "$ver" "$new"
	write_rootfs "$f" "$part"
	progress kernel "$new"
	mount_boot || die bootmount
	mkdir -p "/boot/$new.new" || { umount_boot; die bootfiles; }
	tar -xzf "$WORK/boot.tar.gz" -C "/boot/$new.new" || { umount_boot; die bootfiles; }
	sed -e "s#@ROOT@#$part#" -e "s#@SLOT@#$new#" "$WORK/cmdline.txt.in" > "/boot/$new.new/cmdline.txt" \
		|| { umount_boot; die bootfiles; }
	sync
	mv "/boot/$new.new" "/boot/$new" || { umount_boot; die bootfiles; }
	sync
	# Only a slot whose tries are counted may be booted. If the state cannot
	# be saved, keep the running slot and make the new one unbootable, so
	# not even a manual rollback starts it uncounted.
	mode=flip; tryboot_capable && mode=try
	if ! pending_write "$new" "$cur" "$ver" 0 "$mode"; then
		pending_clear; unboot_slot "$new"; umount_boot; die state
	fi
	if [ "$mode" = try ]; then
		# slot.txt stays on $cur; "pico8os-ota reboot" boots $new once
		tryboot_files "$new" || { pending_clear; unboot_slot "$new"; umount_boot; die bootfiles; }
	else
		write_slot "$new" || { pending_clear; umount_boot; die bootfiles; }
	fi
	umount_boot
	log "slot $new ready ($mode)"
	progress ready "$ver"
}

# Reboot. With an update in "try" mode waiting (or on trial), the next boot
# is a one-shot tryboot of its slot, counted in tries before it starts; past
# MAX_TRIES, or if anything fails, a plain reboot into slot.txt.
do_reboot() {
	ota_lock wait
	if [ -f "$STATE/pending" ] && [ "$(manifest_get mode "$STATE/pending")" = try ]; then
		tryboot_arm || log "plain reboot: no tryboot"
	fi
	sync
	reboot
}
# tryboot_arm: set the flag for the pending slot and count the try.
tryboot_arm() {
	slot=$(manifest_get slot "$STATE/pending")
	prev=$(manifest_get previous "$STATE/pending")
	ver=$(manifest_get version "$STATE/pending")
	tries=$(manifest_get tries "$STATE/pending")
	case $tries in ''|*[!0-9]*) tries=0 ;; esac
	[ "$tries" -lt "$MAX_TRIES" ] || return 1
	mount_boot || return 1
	if ! tryboot_files "$slot"; then umount_boot; return 1; fi
	umount_boot
	# The try is on disk before the flag can start it: a reset at any point
	# never boots a try that was not counted.
	pending_write "$slot" "$prev" "$ver" $((tries + 1)) try || return 1
	if ! "$TRYBOOT" set >/dev/null 2>&1; then
		"$TRYBOOT" clear >/dev/null 2>&1
		# not started: give the try back (if even that fails, the update
		# only loses one of its tries)
		pending_write "$slot" "$prev" "$ver" "$tries" try
		return 1
	fi
	log "tryboot of slot $slot (try $((tries + 1))/$MAX_TRIES)"
}

# Early boot (S06ota), no network needed: count the boots of a freshly
# installed slot. After MAX_TRIES boots that never reached mark-good, boot
# the previous slot again and make the failed one unbootable.
boot_check() {
	ota_lock wait
	[ -f "$STATE/pending" ] || return 0
	slot=$(manifest_get slot "$STATE/pending")
	prev=$(manifest_get previous "$STATE/pending")
	ver=$(manifest_get version "$STATE/pending")
	tries=$(manifest_get tries "$STATE/pending")
	case $tries in ''|*[!0-9]*) tries=0 ;; esac
	case $slot$prev in
		ab|ba) ;;
		*) log "bad pending state; dropping it"; rm -f "$STATE/pending"; sync; return 0 ;;
	esac
	[ "$(manifest_get mode "$STATE/pending")" = try ] && { boot_check_try; return 0; }
	if [ "$(current_slot)" != "$slot" ]; then
		# The firmware booted the other slot (rollback, slot.txt edited by
		# hand): the update is not running, forget it.
		log "pending slot $slot not running; dropping update"
		rm -f "$STATE/pending"; sync; return 0
	fi
	tries=$((tries + 1))
	if [ "$tries" -gt "$MAX_TRIES" ]; then
		boot_rollback "slot $slot failed $MAX_TRIES boots"
	elif ! pending_write "$slot" "$prev" "$ver" "$tries"; then
		# A try that cannot be counted could repeat forever: treat the
		# unsaved count like a failed boot and go back now.
		boot_rollback "cannot save try $tries of slot $slot"
	fi
	log "booting new slot $slot (try $tries/$MAX_TRIES)"
}

# boot_check in "try" mode (each try was counted when it was armed).
boot_check_try() {
	case $(current_slot) in
		"$slot")
			mount_boot || die bootmount
			t=$(boot_target); umount_boot
			if [ "$t" = "$slot" ]; then
				# mark-good wrote slot.txt but could not clear the state
				log "slot $slot is booted by slot.txt; update done"
				pending_clear; return 0
			fi
			log "trying slot $slot (try $tries/$MAX_TRIES)" ;;
		"$prev")
			# not tried yet: the update waits for "pico8os-ota reboot"
			[ "$tries" -gt 0 ] || return 0
			if [ "$tries" -lt "$MAX_TRIES" ]; then
				log "try $tries of slot $slot did not finish: trying again"
				# Reboot only into an armed and counted try. Without one a
				# reboot would come back here with the same count, forever:
				# keep running this (good) slot instead.
				if tryboot_arm; then sync; reboot; exit 3; fi
				log "cannot start another try of slot $slot; staying on $prev"
				progress "error notryboot $ver"
				return 0
			fi
			log "slot $slot failed $tries tries: giving up update $ver"
			mount_boot || die bootmount
			tryboot_disarm; unboot_slot "$slot"
			umount_boot
			pending_clear
			progress "error bootfailed $ver" ;;   # not die: the boot goes on
	esac
}

# boot_rollback REASON (boot_check, with $slot and $prev): boot $prev again
# and make $slot unbootable; if $prev cannot boot, stay on $slot.
boot_rollback() {
	log "$1: rolling back to $prev"
	mount_boot || die bootmount
	if ! write_slot "$prev"; then
		umount_boot
		log "previous slot $prev cannot boot; staying on $slot"
		pending_clear; return 0
	fi
	unboot_slot "$slot"     # running from RAM; its kernel is not needed now
	umount_boot
	# best effort: on the next boot $slot is not running, so a pending
	# file left behind is dropped then
	pending_clear
	reboot; exit 3
}

# The new slot works (S99otagood: up for a while with the PICO-8 session
# running): stop counting. Only for the slot that is running; an update
# that was installed but not booted yet stays pending.
mark_good() {
	ota_lock wait
	[ -f "$STATE/pending" ] || return 0
	[ "$(manifest_get slot "$STATE/pending")" = "$(current_slot)" ] || return 0
	ver=$(manifest_get version "$STATE/pending")
	if [ "$(manifest_get mode "$STATE/pending")" = try ]; then
		# make the trial slot the one config.txt boots
		mount_boot || die bootmount
		{ write_slot "$(current_slot)" && tryboot_disarm; } || { umount_boot; die bootfiles; }
		umount_boot
	fi
	# left in place, the next boots would count on and roll back a working
	# system: say so instead of reporting it as done
	pending_clear || die state
	log "slot $(current_slot) marked good"
	progress updated "$ver"
}

# Boot the other slot, only if it is complete. If an installed update is
# waiting for a reboot, cancel it instead (keep booting this slot).
rollback() {
	ota_lock
	cur=$(current_slot); other=$(other_slot "$cur")
	mount_boot || die bootmount
	if [ -f "$STATE/pending" ] && [ "$(manifest_get mode "$STATE/pending")" = try ]; then
		# slot.txt still names the old slot: give the update up (also while
		# its slot is on trial; the next boot is the old slot then)
		s=$(manifest_get slot "$STATE/pending")
		tryboot_disarm
		case $s in a|b) unboot_slot "$s" ;; esac
		umount_boot
		pending_clear || die state
		progress rolledback; return 0
	fi
	if [ "$(boot_target)" = "$cur" ]; then to=$other; else to=$cur; fi
	if ! slot_bootable "$to"; then umount_boot; die noslot "$to"; fi
	write_slot "$to" || { umount_boot; die bootfiles; }
	umount_boot
	rm -f "$STATE/pending"; sync
	progress rolledback
}

# OTA_URL/latest-<board>.txt:  version=...  url=...  (url may be relative to
# OTA_URL). Flat, so a GitHub Release works as the server:
#   OTA_URL=https://github.com/<user>/<repo>/releases/latest/download
check() {
	[ -n "$OTA_URL" ] || die nourl
	mkdir -p "$RUN"
	wget -q -T 30 -O - "${OTA_URL%/}/latest-$(os_board).txt" 2>/dev/null | head -c $SMALL_MAX > "$RUN/latest.txt"
	[ -s "$RUN/latest.txt" ] || die unreachable
	v=$(manifest_get version "$RUN/latest.txt" | tr -cd '0-9A-Za-z.:_-' | head -c 64)
	[ -n "$v" ] || die badlatest
	if [ "$v" \> "$(os_version)" ]; then
		echo "$v" > "$RUN/ota.available"; progress available "$v"
	else
		rm -f "$RUN/ota.available"; progress uptodate "$(os_version)"
	fi
}

# Download into PICO8DATA/ota/, never more than a valid bundle can be and
# never filling the data partition.
download() {
	check
	[ -f "$RUN/ota.available" ] || return 0
	u=$(manifest_get url "$RUN/latest.txt")
	case $u in http://*|https://*) ;; *) u="${OTA_URL%/}/$u" ;; esac
	mkdir -p "$DATA/ota"
	free=$(( $(df -k "$DATA" | awk 'NR == 2 {print $4}') * 1024 - DATA_RESERVE_MB * 1048576 ))
	max=$(max_bundle); [ "$free" -lt "$max" ] && max=$free
	[ "$max" -gt 0 ] || die nospace
	progress downloading "$(cat "$RUN/ota.available")"
	# a fresh name (O_EXCL): nothing planted under it beforehand is followed
	part=$(mktemp "$DATA/ota/.download.XXXXXX") || die download
	wget -q -T 60 -O - "$u" 2>/dev/null | head -c $((max + 1)) > "$part"
	n=$(file_bytes "$part")
	[ "$n" -gt 0 ] || { rm -f "$part"; die download; }
	[ "$n" -le "$max" ] || { rm -f "$part"; die toolarge; }
	mv "$part" "$DATA/ota/download.pico8os-update"
	sync
	echo "$DATA/ota/download.pico8os-update"
}

status() {
	echo "version=$(os_version)"
	echo "board=$(os_board)"
	echo "slot=$(current_slot)"
	[ -f "$STATE/pending" ] && echo "pending=$(manifest_get version "$STATE/pending")"
	[ -f "$RUN/ota.available" ] && echo "available=$(cat "$RUN/ota.available")"
	[ -f "$STATUS" ] && echo "progress=$(cat "$STATUS")"
	return 0
}

case ${1:-} in
	status) status ;;
	verify)
		ota_lock; progress verifying; verify "${2:?file}" full
		progress valid "$(manifest_get version "$WORK/manifest")" ;;
	apply) apply "${2:?file}" ;;
	check) check ;;
	download) ota_lock; download ;;
	boot-check) boot_check ;;
	mark-good) mark_good ;;
	rollback) rollback ;;
	reboot) do_reboot ;;
	*) sed -n '2,15s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
