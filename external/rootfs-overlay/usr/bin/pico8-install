#!/bin/sh
# Make sure a verified PICO-8 is installed in /opt/pico8 (on the read-only
# root). Sources, in order: a "pico-8" folder or the newest
# pico-8_*_raspi.zip on the PICO8DATA partition, or a zip in the root of a
# USB stick. Every package is checked against the signed list of known-good
# PICO-8 builds first (verify_pico8 in lib.sh, PICO8_VERIFY in pico8os.txt).
. /usr/lib/pico8os/lib.sh
load_config
LOG="$DATA/logs/pico8.log"

log() { mkdir -p "$DATA/logs"; echo "$(date '+%F %T') install: $*" >> "$LOG"; }

# Ready signal for S99otagood: $RUN/install-waiting holds this PID only
# while the "PICO-8 is not installed" screen waits for a zip. Checking or
# installing a package is not "ready" (it may still fail), so it is removed
# first; it is also gone when this script ends.
WAITING="$RUN/install-waiting"
waiting() { mkdir -p "$RUN" && echo $$ > "$WAITING.new" && mv -f "$WAITING.new" "$WAITING"; }
not_waiting() { rm -f "$WAITING" "$WAITING.new"; }
trap not_waiting EXIT
trap 'exit 1' INT TERM
not_waiting

# The root filesystem is writable only while a package is installed.
# PICO-8 (and every cart) must never run on a writable system slot, so the
# session starts only after / is read back as read-only from /proc/mounts.
root_ro() { awk '$2 == "/" { o = $4 } END { exit !(o ~ /^ro(,|$)/) }' /proc/mounts 2>/dev/null; }
ensure_root_ro() { root_ro && return 0; sync; mount -o remount,ro / 2>/dev/null; root_ro; }

# finish: exit 0 (pico8-session starts PICO-8) only on a read-only root.
# Otherwise say so and exit 5; the session is started again later and
# checks the real mount state once more.
finish() {
	ensure_root_ro && exit 0
	log "/ could not be made read-only again; not starting PICO-8"
	say "System error: the system partition is still writable. PICO-8 is not started; restart the console."
	sleep 30
	exit 5
}

# install_from SRC -> install_pico8's return code
install_from() {
	not_waiting
	mount -o remount,rw / 2>/dev/null
	out=$(install_pico8 "$1" "$PICO8_DIR"); rc=$?
	sync
	ensure_root_ro || log "$(basename "$1"): remount read-only failed after installing"
	[ -n "$out" ] && { say "$out"; log "$(basename "$1"): $out"; }
	return $rc
}

banner() {
	clear
	cat <<'MSG'

  ==============================================
               P I C O 8 - O S
  ==============================================
MSG
}

src=$(find_folder) || src=$(find_zip)
if [ -n "$src" ] && [ "$(cat "$PICO8_DIR.meta/source" 2>/dev/null)" != "$(source_sum "$src")" ]; then
	say "Checking and installing PICO-8 from $(basename "$src") ..."
	install_from "$src"; rc=$?
	if [ $rc = 3 ] && update_pico8_hashes; then
		install_from "$src"; rc=$?          # the version may be listed now
	fi
	if [ $rc != 0 ] && is_installed; then
		log "keeping the installed PICO-8 ($(cat "$PICO8_DIR.meta/verify" 2>/dev/null))"
		sleep 5
	fi
fi
is_installed && finish

# Nothing usable installed: explain, then keep trying.
while :; do
	banner
	if [ -n "${rc:-}" ] && [ "$rc" = 3 ]; then
		cat <<MSG

  This PICO-8 version is not on the list of
  verified builds yet. The console checks for
  an updated list every 30 seconds (needs
  network). To install it anyway, set
  PICO8_VERIFY=warn in pico8os.txt.
MSG
	elif [ -n "${rc:-}" ] && [ "$rc" = 4 ]; then
		cat <<'MSG'

  The PICO-8 package was REFUSED: its files do
  not match the verified build, or it is not
  the Raspberry Pi version. It may be damaged
  or modified. Download it again from
  https://www.lexaloffle.com/pico-8.php
MSG
	else
		cat <<'MSG'

  PICO-8 is not installed yet.

  PICO-8 is commercial software by Lexaloffle.
  Buy it at https://www.lexaloffle.com/pico-8.php
  and download the "Raspberry Pi" zip.
MSG
	fi
	cat <<'MSG'

  Copy pico-8_x.y.z_raspi.zip (or the unzipped
  pico-8 folder) to the SD card's PICO8DATA
  drive and reboot, or put the zip in the root
  of a USB stick and plug it in now.
MSG
	waiting
	i=0
	while [ $i -lt 10 ]; do                       # ~30 s per round
		if scan_usb; then
			src=$(find_zip)
			[ -n "$src" ] && { install_from "$src"; rc=$?; [ $rc = 0 ] && finish; continue 2; }
		fi
		sleep 3; i=$((i + 1))
	done
	if [ "${rc:-}" = 3 ] && update_pico8_hashes; then
		src=$(find_folder) || src=$(find_zip)
		[ -n "$src" ] && { install_from "$src"; rc=$?; [ $rc = 0 ] && finish; }
	fi
done
