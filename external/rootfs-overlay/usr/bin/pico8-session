#!/bin/sh
# Runs on tty1 (respawned by init), as root: install if needed, prepare the
# console (keymap, audio, CPU), then run PICO-8 as the unprivileged pico user
# and apply EXIT_ACTION from /data/pico8os.txt.
. /usr/lib/pico8os/lib.sh

LOG=/tmp/pico8.log
FAILS=/tmp/pico8.fastfail

# If PICO-8 was killed (hotkey, crash) SDL could not give the console back:
# un-mute the VT keyboard and leave graphics mode before anything else.
reset_vt() { pico8-hotkey --reset-vt /dev/tty1 2>/dev/null; }

# Root shell on tty1 only with DEBUG=on (root has no password login).
# Otherwise wait and let init start the session again.
drop_to_shell() {
	reset_vt
	if [ "$DEBUG" = on ]; then
		say "DEBUG=on: root shell (exit to restart PICO-8)"
		exec /bin/sh -l
	fi
	sleep "${1:-10}"
	exit 1
}

# CPU frequency policy for smooth frame times (CPU_GOVERNOR in pico8os.txt;
# the firmware still throttles on heat or under-voltage).
setup_cpu() {
	for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
		[ -w "$g" ] && echo "${CPU_GOVERNOR:-performance}" > "$g" 2>/dev/null
	done
}

# Once per boot: how long the kernel took (until init started) and when
# PICO-8 was started, appended to logs/boot.log (last 50 boots).
log_boot_time() {
	[ -f "$RUN/boot-logged" ] && return
	mkdir -p "$RUN" "$DATA/logs"; : > "$RUN/boot-logged"
	hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
	init_at=$(awk -v hz="$hz" '{printf "%.2f", $22 / hz}' /proc/1/stat)
	now=$(cut -d' ' -f1 /proc/uptime)
	f="$DATA/logs/boot.log"
	{ tail -n 49 "$f" 2>/dev/null
	  echo "$(date '+%F %T') $(os_version) slot $(current_slot): kernel ${init_at}s, PICO-8 start ${now}s"
	} > "$f.tmp" && mv "$f.tmp" "$f"
}

pick_binary() {
	case $(uname -m) in
		aarch64|arm64) list="pico8_64" ;;
		*) list="pico8_dyn pico8" ;;
	esac
	for b in $list; do
		[ -x "$PICO8_DIR/$b" ] && { echo "$b"; return 0; }
	done
	return 1
}

# Console keymap. SDL2's evdev keyboard translates keys through the kernel
# keymap of the VT it runs on, so this is what PICO-8 types with. Keymaps are
# global for all VTs, so loading it once per session is enough.
setup_keymap() {
	[ -n "$KEYMAP" ] || KEYMAP=us
	if ! loadkeys -q "$KEYMAP" >/dev/null 2>&1; then
		say "Unknown KEYMAP '$KEYMAP' in pico8os.txt, using us." >>"$LOG"
		loadkeys -q us >/dev/null 2>&1
	fi
}

setup_video() {
	export SDL_VIDEODRIVER="$VIDEO_DRIVER"
	# KMS drivers are modules loaded by udev; give them a moment.
	i=0
	while [ $i -lt 50 ] && ! ls /sys/class/drm/card*-* >/dev/null 2>&1; do
		sleep 0.1; i=$((i + 1))
	done
	# No GPU (QEMU virtio-gpu without virgl, simpledrm): use Mesa software GL.
	for d in /sys/class/drm/card*/device/driver; do
		[ -e "$d" ] || continue
		case $(basename "$(readlink "$d")") in
			virtio*|simpledrm|simple-framebuffer) export LIBGL_ALWAYS_SOFTWARE=1 ;;
		esac
	done
	# Statically linked builds: make their built-in SDL hand over to the
	# system SDL2, which has the kmsdrm backend.
	case $1 in
		*_dyn) ;;
		*) for l in /usr/lib/libSDL2-2.0.so.0 /usr/lib64/libSDL2-2.0.so.0; do
			[ -e "$l" ] && { export SDL_DYNAMIC_API="$l"; break; }
		   done ;;
	esac
}

# Controller mappings: SDL_GameControllerDB from the image. PICO-8 itself
# also reads custom ones from /data/pico8/sdl_controllers.txt.
setup_controllers() {
	db=/usr/share/sdl/gamecontrollerdb.txt
	[ -r "$db" ] && export SDL_GAMECONTROLLERCONFIG_FILE="$db"
}

setup_audio() {
	case $AUDIO_CARD in
		none) export SDL_AUDIODRIVER=dummy; return ;;
		auto) ;;
		*) export SDL_AUDIODRIVER=alsa ALSA_CARD="$AUDIO_CARD"; return ;;
	esac
	cards=$(grep -E '^ *[0-9]+ \[' /proc/asound/cards 2>/dev/null)
	if [ -z "$cards" ]; then
		export SDL_AUDIODRIVER=dummy; return
	fi
	idx=$(printf '%s\n' "$cards" | grep -i hdmi | head -n 1 | awk '{print $1}')
	[ -n "$idx" ] || idx=$(printf '%s\n' "$cards" | head -n 1 | awk '{print $1}')
	export SDL_AUDIODRIVER=alsa ALSA_CARD="$idx"
	amixer -q -c "$idx" sset PCM 90% unmute 2>/dev/null
}

# Keep evidence of a bad exit on the data partition (survives reboot).
save_log() {
	mkdir -p "$DATA/logs"
	{
		echo "=== $(date '+%F %T') $bin exited with code $rc after ${ran}s"
		tail -n 50 "$LOG"
	} >> "$DATA/logs/pico8.log"
	sync
}

load_config
/usr/bin/pico8-install || { sleep 5; exit 1; }

if ! bin=$(pick_binary); then
	say "No PICO-8 binary for $(uname -m) in $PICO8_DIR."
	say "Pi 5 images need pico8_64 (PICO-8 0.2.4 or newer)."
	drop_to_shell 30
fi

mkdir -p "$DATA/carts" "$DATA/screenshots" "$DATA/pico8"
setup_keymap
setup_video "$bin"
setup_controllers
setup_audio
setup_cpu
export HOME="$DATA"

set -- -home "$DATA/pico8" -root_path "$DATA/carts" -desktop "$DATA/screenshots"
# One-shot: open the PICO8-OS settings cart (hotkey, web UI) instead.
next=$(cat "$RUN/next-cart" 2>/dev/null); rm -f "$RUN/next-cart"
SETTINGS_CART="$DATA/carts/pico8os/pico8os.p8"
rm -f "$RUN/settings-active"
if [ "$next" = settings ] && [ -f "$SETTINGS_CART" ]; then
	PICO8_MODE=settings
	set -- "$@" -run "$SETTINGS_CART"
	# lets pico8os-agent accept this cart's requests (see pico8os-agent)
	: > "$RUN/settings-active"
fi
case $PICO8_MODE in
	splore) set -- "$@" -splore ;;
	run) [ -n "$PICO8_CART" ] && set -- "$@" -run "$DATA/carts/$PICO8_CART" ;;
esac
# shellcheck disable=SC2086  # PICO8_ARGS is intentionally word-split
set -- "$@" $PICO8_ARGS

clear
cd "$PICO8_DIR" || exit 1
log_boot_time
started=$(date +%s)
# Drop to the pico user (video/render/input/audio groups). su keeps the
# environment (-p) and execs, so PICO-8's exit status comes back unchanged.
su -p -s /bin/sh pico -c 'exec "$0" "$@"' "$PICO8_DIR/$bin" "$@" >>"$LOG" 2>&1
rc=$?
ran=$(( $(date +%s) - started ))
rm -f "$RUN/settings-active"
reset_vt
[ "$rc" -ne 0 ] && save_log

# Crash-loop guard: three quick failures in a row -> show the log; a root
# shell only with DEBUG=on, otherwise try again after a minute.
if [ "$ran" -lt 5 ] && [ "$rc" -ne 0 ]; then
	n=$(( $(cat "$FAILS" 2>/dev/null || echo 0) + 1 ))
	echo "$n" > "$FAILS"
	if [ "$n" -ge 3 ]; then
		rm -f "$FAILS"
		clear
		say "PICO-8 ($bin) keeps exiting (code $rc). Last log lines:"
		tail -n 15 "$LOG"
		say ""; say "Logs: $DATA/logs/   Settings: $DATA/pico8os.txt"
		sleep 15
		drop_to_shell 60
	fi
	sleep 1
	exit "$rc"
fi
rm -f "$FAILS"

# Killed by a signal (restart hotkey, OOM killer): always start again,
# never apply EXIT_ACTION (that would power off on a restart request).
[ "$rc" -gt 128 ] && exit 0

sync
case $EXIT_ACTION in
	poweroff) poweroff; sleep 30 ;;
	shell) drop_to_shell 1 ;;   # a shell only with DEBUG=on
	*) exit 0 ;;   # restart: init respawns this session
esac
